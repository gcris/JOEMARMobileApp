{
  "expo": {
    "name": "Project JOEMAR",
    "slug": "pnp-geo-tracker-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pnp.geotracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pnp.geotracker",
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./src/assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "queries": [
        {
          "intent": {
            "action": "android.intent.action.DIAL",
            "data": { "scheme": "tel" }
          }
        },
        {
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": { "scheme": "viber" }
          }
        }
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow this app to access your location in the background.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./src/assets/sounds/sos_alert.wav"]
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["./src/assets/sounds/sos_alert.wav"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "29c9d23c-4e2f-4cdf-8370-95fe7e791048"
      }
    },
    "owner": "inppo"
  }
}

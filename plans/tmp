      dayOfWeek: schedule.day_of_week,
      type: schedule.type,
    }));
  } catch (error) {
    console.error("Error fetching schedules by unit id:", error);
    return [];
  }
};

// --- Patrol Log Operations (SQLite) ---
export const savePatrolLogsToLocalStorage = async (
  log: PersonnelLog,
): Promise<void> => {
  try {
    // If Supabase is configured and we are online, try to save to Supabase first
    if (isSupabaseConfigured()) {
      try {
        const { error } = await supabase.from("patrol_logs").insert([log]);
        if (!error) {
          // Successfully saved to Supabase, no need to store locally
          return;
        }
        // If there was an error, fall back to local storage
        console.warn("Failed to save to Supabase, falling back to local storage:", error);
      } catch (error) {
        console.warn("Error saving to Supabase, falling back to local storage:", error);
      }
    }

    // Fallback to local SQLite storage
    const db = getDB();
    db.transaction(tx => {
      tx.executeSql(
        `INSERT INTO patrol_logs (
          id, personnelId, latitude, longitude, speed, networkSignal, dutyType, capturedAt, isSynced
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);`,
        [
          log.id,
          log.personnelId,
          log.latitude,
          log.longitude,
          log.speed,
          log.networkSignal,
          log.dutyType,
          log.capturedAt,
          log.isSynced ? 1 : 0,
        ]
      );
    });
  } catch (err) {
    console.error("[Database] Error saving patrol log to local storage:", err);
  }
};

export const syncPendingPatrolLogs = async (): Promise<boolean> => {
  if (!isSupabaseConfigured()) {
    console.log("[Database] Supabase not configured, skipping sync");
    return false;
  }

  try {
    const db = getDB();
    const logsResult = await executeSql(
      "SELECT * FROM patrol_logs WHERE isSynced = 0;"
    );

    const logs = logsResult.rows._array as PersonnelLog[];

    if (logs.length === 0) {
      console.log("[Database] No pending logs to sync");
      return true;
    }

    console.log(`[Database] Syncing ${logs.length} patrol logs to Supabase`);

    // Attempt to insert all logs into Supabase
    const { error } = await supabase.from("patrol_logs").insert(logs);

    if (error) {
      console.error("[Database] Error syncing patrol logs to Supabase:", error);
      return false;
    }

    // Mark logs as synced in SQLite
    const ids = logs.map(log => log.id);
    const placeholders = ids.map(() => "?").join(",");
    const updateSql = `UPDATE patrol_logs SET isSynced = 1 WHERE id IN (${placeholders});`;

    await executeSql(updateSql, ids);

    console.log(`[Database] Successfully synced and marked ${logs and marked as synced`);
    return true;
  } catch (err) {
    console.error("[Database] Error syncing patrol logs:", err);
    return false;
  }
};


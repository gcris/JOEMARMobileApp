import { supabase, isSupabaseConfigured } from "./supabase";
import { Personnel, Schedule, PersonnelLog } from "../types";
import * as SQLite from 'expo-sqlite';
import { AppState } from "react-native";

// Database setup
let db: SQLite.SQLiteDatabase | null = null;

const getDB = () => {
  if (!db) {
    db = SQLite.openDatabase('patrol.db');
    // Initialize table
    db.transaction(tx => {
      tx.executeSql(
        `CREATE TABLE IF NOT EXISTS patrol_logs (
          id TEXT PRIMARY KEY,
          personnelId TEXT,
          latitude REAL,
          longitude REAL,
          speed REAL,
          networkSignal INTEGER,
          dutyType TEXT,
          capturedAt TEXT,
          isSynced INTEGER
        );`
      );
    });
  }
  return db;
};

// Helper function to execute SQL and return a promise
const executeSql = (sql: string, params: any[] = []): Promise<any> => {
  return new Promise((resolve, reject) => {
    const database = getDB();
    database.transaction(tx => {
      tx.executeSql(
        sql,
        params,
        (_, result) => {
          resolve(result);
        },
        (_, error) => {
          reject(error);
        }
      );
    });
  });
};

// --- Personnel Operations ---
export const getPersonnelByBadge = async (
  badgeNumber: string,
): Promise<Personnel | null> => {
  try {
    const { data, error } = await supabase
      .from("personnel")
      .select("*, rank(*), unit(*), schedule_assignments(*)")
      .eq("badge_number", badgeNumber)
      .single();

    if (error && error.code !== "PGRST116") {
      // PGRST116 means no rows returned
      throw error;
    }

    if (!data) return null;

    return {
      id: data.id,
      badgeNumber: data.badge_number,
      rank: data.rank,
      rankId: data.rank_id,
      fullname: data.fullname,
      unitId: data.unit_id,
      unit: data.unit,
      designation: data.designation,
      phoneNumber: data.phone_number,
      viberNumber: data.viber_number,
      isApproved: data.is_approved,
      role: data.role,
      email: data.email,
      photo_url: data.photo_url, // Add photo URL
      fcm_token: data.fcm_token,
    };
  } catch (error) {
    console.error("Error fetching personnel by badge:", error);
    return null;
  }
};

